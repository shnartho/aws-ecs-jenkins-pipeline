# Copy to terraform.tfvars (in this bootstrap/ directory) and fill in before running
# `terraform apply` here. This module uses LOCAL state - see providers.tf for why.

state_bucket_name = "miniclip-tfstate-123456789012" # replace with a globally unique bucket name

# Name specific IAM principals here (your IAM user, and/or any CI role), not the account root.
trusted_principal_arns = [
  "arn:aws:iam::123456789012:user/REPLACE_WITH_YOUR_IAM_USERNAME",
]

# Local AWS CLI profile authenticated as the org's management account - required for
# the Identity Center resources in sso.tf. Your ambient/default credentials (used for everything
# else in this module) should instead be the workload account (e.g. gold-restaurant).
management_aws_profile = "REPLACE_WITH_MANAGEMENT_ACCOUNT_PROFILE_NAME"

sso_target_account_id = "123456789012" # replace with the workload account ID
sso_user_name          = "REPLACE_WITH_SSO_USERNAME"
